{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vitest/globals"]
  },
  // Explicit roots, not "**/*.ts": the glob pulled every scratch file in the
  // repository into the program, so an unrelated probe in drafts/ or
  // coverage/ broke `npm run typecheck` and the pre-push hook. A fork keeps
  // working: its sources live in src/ or server/, both listed below.
  "include": ["src", "server", "scripts", "tests", "vitest.config.ts"]
}
