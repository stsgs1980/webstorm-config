{
  "author": "stsgs1980",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "description": "WebStorm template with ESLint, Prettier, Stylelint, markdownlint, TypeScript, Husky, and AI rules",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "8.0.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^5.0.5",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-angular": "^9.4.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli": "^0.50.0",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "webstorm",
    "eslint",
    "prettier",
    "typescript",
    "husky",
    "template"
  ],
  "license": "MIT",
  "lint-staged": {
    "*.{js,ts,jsx,tsx,mjs,cjs,mts,cts,json,html,md,vue,svelte,astro,scss,css,less,yaml}": "prettier --write",
    "*.{js,ts,jsx,tsx,mjs,cjs,mts,cts}": "eslint --fix --max-warnings=0 --no-warn-ignored",
    "*.{css,scss}": "stylelint --fix",
    "*.md": "markdownlint --fix --ignore node_modules"
  },
  "name": "webstorm-config",
  "repository": {
    "type": "git",
    "url": "https://github.com/stsgs1980/webstorm-config.git"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:prettier-conflicts": "eslint-config-prettier scripts/check-docs.ts",
    "lint:metrics": "eslint . --config eslint.metrics.config.js --no-warn-ignored",
    "lint:css": "stylelint \"**/*.{css,scss}\" --allow-empty-input",
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules --ignore drafts",
    "check:file-length": "node scripts/check-file-length.ts --all",
    "check:docs": "node scripts/check-docs.ts",
    "check:templates": "node scripts/check-templates.ts",
    "check:style-consistency": "node scripts/check-style-consistency.ts",
    "sync:ide": "node scripts/sync-ide-settings.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "pretest": "node scripts/check-test-files.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pretest:coverage": "node scripts/check-test-files.ts",
    "prepare": "husky",
    "changelog": "node scripts/generate-changelog.ts"
  },
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=10.9.0"
  },
  "type": "module",
  "overrides": {
    "katex": "^0.19.1",
    "re2js": "2.9.1",
    "smol-toml": "^1.9.1",
    "js-yaml": "^5.5.0",
    "minimatch": ">=11.0.1",
    "eslint-plugin-react": {
      "eslint": "^10.14.0"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "^10.14.0"
    }
  },
  "version": "1.0.0"
}
