# Enforce LF line endings for shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Enforce LF for other scripts
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.astro text eol=lf

# Enforce LF for config files
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.xml text eol=lf
# IntelliJ module files are XML too; without the rule they follow core.autocrlf.
*.iml text eol=lf

# Enforce LF for git hooks
.husky/* text eol=lf

# Keep CRLF for Windows scripts a fork may add. The template ships no .cmd,
# .bat or .ps1 files, so this block matches nothing in this repository.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary
*.png binary
*.jpg binary

# Extensionless config files — LF regardless of core.autocrlf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
.prettierrc text eol=lf
.prettierignore text eol=lf
.markdownlintignore text eol=lf
.stylelintignore text eol=lf
.nvmrc text eol=lf
.npmrc text eol=lf
.env.example text eol=lf
# LICENSE has no extension; core.autocrlf would otherwise decide its endings.
LICENSE text eol=lf
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary
